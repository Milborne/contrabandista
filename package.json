{
  "name": "contrabandista",
  "version": "0.1.0",
  "private": true,
  "description": "Extensión Chromium local para identificar patrones oscuros.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config extension/vite.config.ts",
    "build": "vite build --config extension/vite.config.ts",
    "lint": "eslint . && node extension/privacy-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@playwright/test": "^1.56.1",
    "@types/chrome": "^0.1.36",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "license": "Apache-2.0"
}
